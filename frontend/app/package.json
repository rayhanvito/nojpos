{
  "name": "web",
  "private": true,
  "version": "1.0.5",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "build:offline": "vite build --config vite.offline.config.ts",
    "knip": "knip",
    "depcruise": "depcruise src --config .dependency-cruiser.cjs --ignore-known .dependency-cruiser-known-violations.json",
    "e2e": "playwright test",
    "gen:api": "openapi-typescript ../../backend/api/openapi.yaml -o src/shared/api/openapi.d.ts"
  },
  "devDependencies": {
    "@base-ui/react": "^1.7.0",
    "@fontsource/poppins": "^5.3.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dependency-cruiser": "^18.6.0",
    "knip": "^6.41.0",
    "lucide-react": "^1.34.0",
    "openapi-typescript": "^7.13.0",
    "oxlint": "^1.79.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-is": "^19.2.8",
    "react-router": "^8.3.0",
    "recharts": "^3.8.0",
    "shadcn": "^4.19.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.2"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "@tanstack/react-query": "^5.104.3",
    "exceljs": "^4.4.0",
    "xlsx": "^0.18.5"
  }
}