# Server-only Laravel API base URL for Next.js BFF route handlers.
# Do not expose this as NEXT_PUBLIC_* and do not call Laravel directly from Client Components.
BACKEND_INTERNAL_API_URL=http://127.0.0.1:8000/api/v1

# Server-only Web Admin session cookie settings.
WEB_SESSION_COOKIE_NAME=nojpos_web_session
WEB_SESSION_SECRET=change-me-to-at-least-32-random-characters
WEB_SESSION_TTL_SECONDS=28800
WEB_LOGIN_DEVICE_UUID_NAMESPACE=web-admin
